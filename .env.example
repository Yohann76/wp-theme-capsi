# Copier ce fichier en .env et remplir les valeurs réelles.
# cp .env.example .env
# .env n'est jamais versionné.

# ---- WP Mail SMTP ----
SMTP_HOST=smtp.example.com # important and must be configured
SMTP_PORT=587
SMTP_ENCRYPTION=tls          # tls | ssl | none
SMTP_USER=contact@example.com
SMTP_PASS=your_smtp_password
