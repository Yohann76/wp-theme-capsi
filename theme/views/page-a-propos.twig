{% extends "base.twig" %}

{% block content %}
<main id="main" class="page-about">

    <div class="page-hero page-hero--about">
        <div class="container">
            <span class="eyebrow">Pépinière artisanale · Paris</span>
            <h1 class="page-hero__title">{{ post.title }}</h1>
            <p class="page-hero__desc">Piments rares et plantes aromatiques d'exception — cultivés à la main depuis 2018.</p>
            <div class="about-hero-stats">
                <div class="about-hero-stat">
                    <strong>200+</strong><span>variétés</span>
                </div>
                <div class="about-hero-stat-sep" aria-hidden="true"></div>
                <div class="about-hero-stat">
                    <strong>5</strong><span>espèces <em>Capsicum</em></span>
                </div>
                <div class="about-hero-stat-sep" aria-hidden="true"></div>
                <div class="about-hero-stat">
                    <strong>2018</strong><span>fondation</span>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="about-content">
            {{ post.content }}
        </div>
    </div>

</main>
{% endblock %}
