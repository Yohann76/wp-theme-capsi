{% extends "base.twig" %}

{% block content %}
<main id="main">
    <div class="container">
        {% for post in posts %}
            <article class="post-card">
                {% if post.thumbnail %}
                    <a href="{{ post.link }}">
                        <img src="{{ post.thumbnail.src('medium') }}" alt="{{ post.thumbnail.alt }}">
                    </a>
                {% endif %}
                <h2><a href="{{ post.link }}">{{ post.title }}</a></h2>
                <p class="post-meta">{{ post.date('d/m/Y') }}</p>
                <p>{{ post.excerpt }}</p>
                <a href="{{ post.link }}" class="btn">Lire la suite</a>
            </article>
        {% else %}
            <p>Aucun article pour le moment.</p>
        {% endfor %}
    </div>
</main>
{% endblock %}
