{% extends "base.twig" %}

{% block content %}
<main id="main">

    <section class="blog-header">
        <div class="container">
            <span class="eyebrow">Journal de l'Atelier</span>
            <h1 class="blog-header__title">Le Blog</h1>
            <p class="blog-header__desc">Culture, variétés rares, recettes et coulisses de l'Atelier.</p>
        </div>
    </section>

    <section class="blog-posts">
        <div class="container">
            {% if posts %}
                <div class="posts-grid">
                    {% for post in posts %}
                        {% set cats = post.terms('category') %}
                        <article class="post-card">

                            <a href="{{ post.link }}" class="post-card__image-link" tabindex="-1" aria-hidden="true">
                                <div class="post-card__image-wrap">
                                    {% if post.thumbnail %}
                                        <img src="{{ post.thumbnail.src('medium_large') }}"
                                             alt="{{ post.thumbnail.alt }}"
                                             class="post-card__image"
                                             loading="lazy">
                                    {% else %}
                                        <div class="post-card__placeholder">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 96" aria-hidden="true" class="post-card__placeholder-icon">
                                                <defs>
                                                    <linearGradient id="ph-blog-g" x1="0%" y1="100%" x2="0%" y2="0%">
                                                        <stop offset="0%" stop-color="#3A6848" stop-opacity="0.7"/>
                                                        <stop offset="100%" stop-color="#7ABB8A" stop-opacity="0.5"/>
                                                    </linearGradient>
                                                </defs>
                                                <!-- Tige principale -->
                                                <path d="M 40,92 C 40,76 40,62 40,50" stroke="url(#ph-blog-g)" stroke-width="3.5" fill="none" stroke-linecap="round"/>
                                                <!-- Branche gauche (piment) -->
                                                <path d="M 40,50 C 33,38 23,24 14,11" stroke="url(#ph-blog-g)" stroke-width="3" fill="none" stroke-linecap="round"/>
                                                <!-- Branche droite (aromatique) -->
                                                <path d="M 40,50 C 47,38 57,24 66,11" stroke="url(#ph-blog-g)" stroke-width="3" fill="none" stroke-linecap="round"/>
                                                <!-- Feuille gauche -->
                                                <ellipse cx="24" cy="33" rx="8" ry="3.5" fill="#6AAA78" opacity="0.55" transform="rotate(-42 24 33)"/>
                                                <!-- Feuille droite -->
                                                <ellipse cx="56" cy="33" rx="8" ry="3.5" fill="#6AAA78" opacity="0.55" transform="rotate(42 56 33)"/>
                                                <!-- Nœud de fourche -->
                                                <circle cx="40" cy="50" r="3.5" fill="#B8832A" opacity="0.6"/>
                                                <!-- Piment gauche -->
                                                <ellipse cx="14" cy="11" rx="3.5" ry="5.5" fill="#B8832A" opacity="0.55" transform="rotate(-12 14 11)"/>
                                                <!-- Cluster aromatique droite -->
                                                <circle cx="66" cy="13" r="4" fill="#7ABB8A" opacity="0.55"/>
                                                <circle cx="61" cy="8"  r="3" fill="#7ABB8A" opacity="0.45"/>
                                                <circle cx="71" cy="8"  r="3" fill="#7ABB8A" opacity="0.45"/>
                                            </svg>
                                        </div>
                                    {% endif %}
                                </div>
                            </a>

                            <div class="post-card__body">
                                {% if cats %}
                                    <span class="post-card__cat">{{ cats[0].name }}</span>
                                {% endif %}

                                <h2 class="post-card__title">
                                    <a href="{{ post.link }}">{{ post.title }}</a>
                                </h2>

                                <time class="post-card__date" datetime="{{ post.date('Y-m-d') }}">
                                    {{ post.date('d/m/Y') }}
                                </time>

                                <p class="post-card__excerpt">{{ post.excerpt }}</p>

                                <a href="{{ post.link }}" class="post-card__cta">
                                    Lire la suite
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </a>
                            </div>

                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <p class="blog-empty">Aucun article pour le moment.</p>
            {% endif %}
        </div>
    </section>

</main>
{% endblock %}
