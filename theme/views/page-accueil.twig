{% extends "base.twig" %}

{% set cat_meta = {
  'Graines': {
    'desc': 'Plus de 50 variétés rares de piments et plantes aromatiques, sélectionnées pour leur germination et leur caractère.',
    'icon': '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M5 12C5 6.5 8.5 3 12 3s7 3.5 7 9c0 2-1 3.5-3 4.5"/><path d="M12 12c-2-1-4-3-4-6"/></svg>'
  },
  'Plants': {
    'desc': 'Des plants vigoureux — piments et aromatiques rares — élevés à la main dans notre serre.',
    'icon': '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V13"/><path d="M5 9c0-4 2.5-6 7-6 4.5 0 7 2 7 6s-3 7-7 7c-3 0-7-2-7-7z"/><path d="M12 13C10 11 8 8 8 5"/></svg>'
  }
} %}

{% block content %}
<main id="main" class="home-page">

  {# ——— HERO ——— #}
  <section class="home-hero">
    <div class="home-hero__bg" aria-hidden="true">
      <div class="home-hero__glow home-hero__glow--1"></div>
      <div class="home-hero__glow home-hero__glow--2"></div>
      <div class="home-hero__grain"></div>
    </div>

    <div class="container">
      <div class="home-hero__inner">
        <span class="eyebrow home-hero__eyebrow">{{ capsi.hero_eyebrow }}</span>

        <h1 class="home-hero__title">
          <span class="home-hero__title-line">{{ capsi.hero_title_1 }}</span>
          <em class="home-hero__title-em">{{ capsi.hero_title_em }}</em>
        </h1>

        <p class="home-hero__desc">{{ capsi.hero_desc }}</p>

        <div class="home-hero__actions">
          <a href="{{ capsi.hero_cta1_url }}" class="btn btn--primary btn--lg">
            {{ capsi.hero_cta1_text }}
          </a>
          <a href="{{ capsi.hero_cta2_url }}" class="btn btn--ghost btn--lg">
            {{ capsi.hero_cta2_text }}
          </a>
        </div>

        <div class="home-hero__stats">
          <div class="home-hero__stat">
            <strong>100%</strong>
            <span>Artisanal</span>
          </div>
          <div class="home-hero__stat-sep" aria-hidden="true"></div>
          <div class="home-hero__stat">
            <strong>30+</strong>
            <span>Variétés rares</span>
          </div>
          <div class="home-hero__stat-sep" aria-hidden="true"></div>
          <div class="home-hero__stat">
            <strong>5</strong>
            <span>Espèces cultivées</span>
          </div>
        </div>
      </div>
    </div>

    <a href="#after-hero" class="home-hero__scroll" aria-label="Défiler">
      <span class="home-hero__scroll-label">Défiler</span>
      <div class="home-hero__scroll-track"><div class="home-hero__scroll-thumb"></div></div>
    </a>
  </section>

  <span id="after-hero"></span>

  {# ——— TICKER ——— #}
  <div class="home-ticker" aria-hidden="true">
    <div class="home-ticker__track">
      {% for i in 1..3 %}
        {% for item in capsi.ticker_items %}
          <span>{{ item }}</span><span class="home-ticker__sep">✦</span>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  {# ——— CATÉGORIES ——— #}
  <section class="home-section home-section--cats">
    <div class="container">

      <header class="home-section__head animate-in">
        <span class="eyebrow">Nos créations</span>
        <h2 class="home-section__title">Deux familles,<br>une passion commune</h2>
      </header>

      <div class="home-cats">
        {% for cat in footer_product_cats %}
          {% set meta = cat_meta[cat.name] ?? { 'desc': '', 'icon': '' } %}
          <a href="{{ cat.url }}" class="home-cat animate-in">
            <div class="home-cat__icon">{{ meta.icon|raw }}</div>
            <div class="home-cat__body">
              <h3 class="home-cat__name">{{ cat.name }}</h3>
              <p class="home-cat__desc">{{ meta.desc }}</p>
            </div>
            <span class="home-cat__cta">
              Découvrir
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        {% endfor %}
      </div>

    </div>
  </section>

  {# ——— PROCESSUS ——— #}
  <section class="home-section home-section--process">
    <div class="container">

      <header class="home-section__head home-section__head--center animate-in">
        <span class="eyebrow">Notre méthode</span>
        <h2 class="home-section__title">De A à Z<br>dans l'atelier</h2>
        <p class="home-section__sub">
          Pas d'intermédiaire, pas de sous-traitance. Chaque étape se passe ici.
        </p>
      </header>

      <div class="home-process">

        <div class="home-process__step animate-in">
          <div class="home-process__num">01</div>
          <div class="home-process__content">
            <h3>Sélection</h3>
            <p>Nous sourceons les semences les plus rares depuis les quatre coins du monde — Amérique du Sud, Asie du Sud-Est, bassin méditerranéen.</p>
          </div>
        </div>

        <div class="home-process__connector" aria-hidden="true"></div>

        <div class="home-process__step animate-in">
          <div class="home-process__num">02</div>
          <div class="home-process__content">
            <h3>Culture</h3>
            <p>Chaque graine est semée à la main. Les plants grandissent dans notre serre parisienne, sans intrant chimique, à notre rythme.</p>
          </div>
        </div>

        <div class="home-process__connector" aria-hidden="true"></div>

        <div class="home-process__step animate-in">
          <div class="home-process__num">03</div>
          <div class="home-process__content">
            <h3>Récolte</h3>
            <p>La récolte se fait à maturité optimale, en petites quantités. C'est pour cela que le stock fluctue — et que chaque lot est unique.</p>
          </div>
        </div>

        <div class="home-process__connector" aria-hidden="true"></div>

        <div class="home-process__step animate-in">
          <div class="home-process__num">04</div>
          <div class="home-process__content">
            <h3>Confection</h3>
            <p>Graines triées et sachets numérotés par lot, plants mis en pot un à un — tout est conditionné et étiqueté à la main dans notre atelier.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  {# ——— PRODUITS EN AVANT ——— #}
  {% if featured_products %}
  <section class="home-section home-section--products">
    <div class="container">

      <header class="home-section__head animate-in">
        <span class="eyebrow">En ce moment</span>
        <h2 class="home-section__title">Dernières créations</h2>
      </header>

      <div class="home-products">
        {% for p in featured_products %}
          <a href="{{ p.url }}" class="home-product animate-in">
            <div class="home-product__img-wrap">
              {% if p.image %}
                <img src="{{ p.image }}" alt="{{ p.title }}" loading="lazy">
              {% else %}
                <div class="home-product__placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22V12"/><path d="M5 12C5 6.5 8.5 3 12 3s7 3.5 7 9"/></svg>
                </div>
              {% endif %}
              {% if p.on_sale %}
                <span class="home-product__badge">Promo</span>
              {% endif %}
            </div>
            <div class="home-product__body">
              {% if p.cats %}
                <span class="home-product__cat">{{ p.cats[0] }}</span>
              {% endif %}
              <h3 class="home-product__name">{{ p.title }}</h3>
              <div class="home-product__price">
                {% if p.on_sale %}
                  <del>{{ p.regular_price|raw }}</del>
                {% endif %}
                {{ p.price|raw }}
              </div>
            </div>
          </a>
        {% endfor %}
      </div>

      <div class="home-section__more animate-in">
        <a href="{{ fn('wc_get_page_permalink', 'shop') }}" class="btn btn--outline">
          Voir toute la boutique
        </a>
      </div>

    </div>
  </section>
  {% endif %}

  {# ——— MANIFESTE ——— #}
  <section class="home-manifesto animate-in">
    <div class="container">
      <div class="home-manifesto__inner">
        <span class="eyebrow home-manifesto__eyebrow">{{ capsi.manifesto_eyebrow }}</span>
        <blockquote class="home-manifesto__quote">{{ capsi.manifesto_quote }}</blockquote>
        <p class="home-manifesto__text">{{ capsi.manifesto_text }}</p>
        <a href="{{ capsi.hero_cta2_url }}" class="btn btn--primary">
          {{ capsi.hero_cta2_text }}
        </a>
      </div>
    </div>
  </section>

</main>
{% endblock %}
