{% extends "base.twig" %}

{% block content %}
<main id="main" class="page-contact">

    <div class="page-hero">
        <div class="container">
            <span class="eyebrow">Nous contacter</span>
            <h1 class="page-hero__title">{{ post.title }}</h1>
            <p class="page-hero__desc">Une question sur une variété, une commande ou un partenariat ? Nous répondons sous 24h ouvrées.</p>
        </div>
    </div>

    <div class="container">
        <div class="contact-layout">

            {# — Infos de contact — #}
            <aside class="contact-info">

                {% if capsi.email %}
                    <div class="contact-info__item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
                        <div>
                            <span class="contact-info__label">Email</span>
                            <a href="mailto:{{ capsi.email }}">{{ capsi.email }}</a>
                        </div>
                    </div>
                {% endif %}

                {% if capsi.phone %}
                    <div class="contact-info__item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.25h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 5.55 5.55l1.62-1.62a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        <div>
                            <span class="contact-info__label">Téléphone</span>
                            <a href="tel:{{ capsi.phone|replace({' ': ''}) }}">{{ capsi.phone }}</a>
                        </div>
                    </div>
                {% endif %}

                {% if capsi.address %}
                    <div class="contact-info__item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        <div>
                            <span class="contact-info__label">Adresse</span>
                            <span>{{ capsi.address|nl2br }}</span>
                        </div>
                    </div>
                {% endif %}

                {% if capsi.hours %}
                    <div class="contact-info__item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <div>
                            <span class="contact-info__label">Horaires</span>
                            <span>{{ capsi.hours }}</span>
                        </div>
                    </div>
                {% endif %}

            </aside>

            {# — Formulaire — #}
            <div class="contact-form-wrap">

                {% if contact_status == 'success' %}
                    <div class="contact-notice contact-notice--success" role="alert">
                        <strong>Message envoyé.</strong> Nous vous répondrons sous 24h ouvrées.
                    </div>
                {% elseif contact_status == 'error' %}
                    <div class="contact-notice contact-notice--error" role="alert">
                        Une erreur est survenue. Merci de réessayer ou de nous écrire directement.
                    </div>
                {% endif %}

                <form action="{{ fn('admin_url', 'admin-post.php') }}" method="post" class="contact-form" novalidate>
                    <input type="hidden" name="action"   value="capsi_contact">
                    <input type="hidden" name="_wpnonce" value="{{ contact_nonce }}">

                    <div class="form-row form-row--2col">
                        <div class="form-field">
                            <label for="contact-name">Nom complet <span aria-hidden="true">*</span></label>
                            <input type="text" id="contact-name" name="contact_name"
                                   placeholder="Jean Dupont" required autocomplete="name">
                        </div>
                        <div class="form-field">
                            <label for="contact-email">Email <span aria-hidden="true">*</span></label>
                            <input type="email" id="contact-email" name="contact_email"
                                   placeholder="jean@exemple.fr" required autocomplete="email">
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="contact-subject">Sujet</label>
                        <select id="contact-subject" name="contact_subject">
                            <option value="">— Choisir un sujet —</option>
                            <option value="commande">Question sur une commande</option>
                            <option value="produit">Renseignement produit</option>
                            <option value="culture">Conseil de culture</option>
                            <option value="pro">Commande professionnelle</option>
                            <option value="autre">Autre</option>
                        </select>
                    </div>

                    <div class="form-field">
                        <label for="contact-message">Message <span aria-hidden="true">*</span></label>
                        <textarea id="contact-message" name="contact_message"
                                  rows="6" placeholder="Votre message…" required></textarea>
                    </div>

                    <button type="submit" class="contact-submit">
                        Envoyer le message
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    </button>
                </form>
            </div>

        </div>
    </div>

</main>
{% endblock %}
