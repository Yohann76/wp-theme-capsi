{% extends "base.twig" %}

{% block content %}
<main id="main" class="page-legal">

    <div class="page-hero page-hero--sm">
        <div class="container">
            <h1 class="page-hero__title page-hero__title--sm">{{ post.title }}</h1>
        </div>
    </div>

    <div class="container">
        <div class="legal-content">
            {{ post.content }}
        </div>
    </div>

</main>
{% endblock %}
