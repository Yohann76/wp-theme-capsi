{% extends "base.twig" %}

{% block content %}
<main id="main">

    {# ——— Hero ——— #}
    <header class="post-hero">
        <div class="container">

            <nav class="post-breadcrumb" aria-label="Fil d'Ariane">
                <a href="{{ fn('get_permalink', fn('get_option', 'page_for_posts')) }}" class="post-breadcrumb__link">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                    Journal de l'Atelier
                </a>
            </nav>

            <div class="post-hero__meta">
                {% set cats = post.terms('category') %}
                {% if cats %}
                    <a href="{{ cats[0].link }}" class="post-hero__cat">{{ cats[0].name }}</a>
                    <span class="post-hero__sep" aria-hidden="true">·</span>
                {% endif %}
                <time class="post-hero__date" datetime="{{ post.date('Y-m-d') }}">{{ post.date('d F Y') }}</time>
                {% set word_count = post.content | striptags | split(' ') | length %}
                {% set reading_time = max(1, (word_count / 200) | round) %}
                <span class="post-hero__sep" aria-hidden="true">·</span>
                <span class="post-hero__reading-time">{{ reading_time }} min de lecture</span>
            </div>

            <h1 class="post-hero__title">{{ post.title }}</h1>

            {% if post.excerpt %}
            <p class="post-hero__excerpt">{{ post.excerpt | striptags }}</p>
            {% endif %}

        </div>
    </header>

    {# ——— Image à la une ——— #}
    {% if post.thumbnail %}
    <div class="post-image">
        <div class="container">
            <figure class="post-image__figure">
                <img src="{{ post.thumbnail.src('large') }}"
                     alt="{{ post.thumbnail.alt ?: post.title }}"
                     class="post-image__img"
                     loading="eager"
                     width="{{ post.thumbnail.width }}"
                     height="{{ post.thumbnail.height }}">
            </figure>
        </div>
    </div>
    {% endif %}

    {# ——— Corps de l'article ——— #}
    <div class="post-body">
        <div class="container">
            <div class="post-content">
                {{ post.content }}
            </div>

            <footer class="post-footer">
                {% set cats = post.terms('category') %}
                {% if cats %}
                <div class="post-footer__cats">
                    <span class="post-footer__cats-label">Catégorie</span>
                    {% for cat in cats %}
                        <a href="{{ cat.link }}" class="post-footer__cat">{{ cat.name }}</a>
                    {% endfor %}
                </div>
                {% endif %}

                <a href="{{ fn('get_permalink', fn('get_option', 'page_for_posts')) }}" class="post-back-link">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                    Retour au journal
                </a>
            </footer>
        </div>
    </div>

</main>
{% endblock %}
