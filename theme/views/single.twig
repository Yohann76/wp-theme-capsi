{% extends "base.twig" %}

{% block content %}
<main id="main">
    <div class="container">
        <article class="single-post">
            <h1>{{ post.title }}</h1>
            <p class="post-meta">{{ post.date('d/m/Y') }}</p>

            {% if post.thumbnail %}
                <img src="{{ post.thumbnail.src('large') }}" alt="{{ post.thumbnail.alt }}">
            {% endif %}

            <div class="post-content">
                {{ post.content }}
            </div>
        </article>
    </div>
</main>
{% endblock %}
