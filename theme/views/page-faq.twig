{% extends "base.twig" %}

{% block content %}
<main id="main" class="page-faq">

    <div class="page-hero">
        <div class="container">
            <span class="eyebrow">Support</span>
            <h1 class="page-hero__title">{{ post.title }}</h1>
            <p class="page-hero__desc">Toutes les réponses à vos questions sur nos graines, nos plants, la livraison et la culture des piments et plantes aromatiques.</p>
        </div>
    </div>

    <div class="container">
        <div class="faq-list">
            {% if post.content %}
                {{ post.content }}
            {% else %}
                <p class="faq-empty">Aucune question pour le moment.</p>
            {% endif %}
        </div>
    </div>

</main>
{% endblock %}
